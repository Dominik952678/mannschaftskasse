# Zugangsdaten des Supabase-Projekts (Dashboard → Project Settings → API).
# Ohne diese beiden Werte läuft die App im lokalen Modus: alles im Speicher,
# Anmeldung mit dem Entwicklungs-Code aus src/data/anfang.ts.
#
# Kopieren nach `.env.local` — die Datei ist über .gitignore ausgeschlossen.
#
# Der anon key darf öffentlich sein: er kommt nur durch die RLS-Policies,
# die in supabase/migrations/0001_schema.sql stehen.

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key
